on swap hand items:
	if {ability::iris::%uuid of player%} is true:
		if name of player's tool is "&d능력 사용":
			cancel event
			
			# 쿨타임 체크 (20초)
			if {iris_cooldown::%uuid of player%} is set:
				set {_waited} to difference between {iris_cooldown::%uuid of player%} and now
				if {_waited} is less than 20 seconds:
					set {_remaining} to 20 seconds
					remove {_waited} from {_remaining}
					set {_r_int} to round(seconds of {_remaining})
					send "&a[시스템] <#9A5CC6>능력 재사용까지 &e%{_r_int}%초 <#9A5CC6>남았습니다." to player
					stop

			# 팀 설정 및 효과 부여 (30초 지속)
			execute console command "team add purple"
			execute console command "team modify purple color purple"
			loop all players:
				if {ability::iris::%uuid of loop-player%} is true:
					execute console command "team join purple %loop-player%"
					apply glowing 3 without particles to loop-player for 30 seconds
					apply resistance 3 without particles to loop-player for 30 seconds

			# 스킬 연출
			set {_origin} to location of player
			add 0.2 to y-coordinate of {_origin}
			set {_x} to x-coordinate of {_origin}
			set {_y} to y-coordinate of {_origin}
			set {_z} to z-coordinate of {_origin}
			
			loop 2 times:
				execute console command "particle flash{color:[0.5,0.0,1.0,1.0]} %{_x}% %{_y}% %{_z}% 0 0 0 0 1 normal"
				wait 1 tick

			loop 6 times:
				set {_r} to loop-number * 0.5 
				loop 20 times:
					set {_a} to (loop-number-2 * 18)
					set {_p} to {_origin}.clone()
					add ({_r} * cos({_a})) to x-coordinate of {_p}
					add ({_r} * sin({_a})) to z-coordinate of {_p}
					make 1 of dust using dustOption(purple, 1) at {_p} with offset vector(0, 0, 0) with extra 0 
				if loop-number is 2 or 4 or 6:
					wait 1 tick
			
			play sound "entity.generic.explode" with volume 0.7 with pitch 1.8 to player
			
			# 쿨타임 기록
			set {iris_cooldown::%uuid of player%} to now