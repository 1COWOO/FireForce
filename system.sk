on load:
	send "에@흐 챗지피티는 이거도 못만드나" to console
on tab complete of "/reset" or "/ability":
	set tab completions for position 1 to "tamaki" and "kusakabe" and "iris"
function giveAbility(p: player, type: string):
	if {ability::%{_type}%::%uuid of {_p}%} is true:
		send "&a[시스템] &e'%{_type}%' &c능력이 이미 부여되어있습니다." to {_p}
		play sound "ENTITY_PLAYER_ATTACK_CRIT" to {_p}
		stop
	if {_type} is "tamaki":
		apply infinite speed 3 without particles to {_p}
		apply infinite jump boost 3 without particles to {_p}
		set {_p}'s safe fall distance attribute to 999999999
	else if {_type} is "kusakabe":
		give 1 of goat horn named "&c능력 사용" to {_p}
	else if {_type} is "iris":
		give 1 of end crystal named "&d능력 사용" to {_p}
	else:
		send "&a[시스템] &e'%{_type}%'&c은 존재하지 않는 능력 입니다." to {_p}
		play sound "ENTITY_PLAYER_ATTACK_CRIT" to {_p}
		stop
	set {ability::%{_type}%::%uuid of {_p}%} to true
	apply infinite fire resistance 255 without particles to {_p}
	send "&a[시스템] &e'%{_type}%' &b능력이 부여되었습니다." to {_p}
	play sound "ITEM_FLINTANDSTEEL_USE" to {_p}

function resetAbility(p: player, type: string):
	if {_type} is "all":
		send "&a[시스템] &e'모든' &c능력이 부여 해제 됐습니다." to {_p}
		if {_p}'s gamemode is not creative:
			set {_p}'s flight mode to false
		clear all the potion effects of {_p}
		execute console command "/attribute %uuid of {_p}% minecraft:movement_speed base reset"
		delete {ability::tamaki::%uuid of {_p}%}
		delete {ability::kusakabe::%uuid of {_p}%}
		delete {ability::iris::%uuid of {_p}%}
		delete {iris_cooldown::%uuid of {_p}%}
		delete {nekofire::%uuid of {_p}%}
		delete {kusakabe_ab::%uuid of {_p}%}
		delete {kusakabe_cooldown::%uuid of {_p}%}
		execute console command "team leave %{_p}%"
		remove fire resistance from {_p}
		remove goat horn named "&c능력 사용" from {_p}'s inventory
		remove fire charge named "&7관전자로 변경" from {_p}'s inventory
		remove end crystal named "&d능력 사용" from {_p}'s inventory
		play sound "BLOCK_FIRE_EXTINGUISH" to {_p}
		stop
	else if {_type} is "tamaki":
		if {ability::tamaki::%uuid of {_p}%} is not set:
			send "&a[시스템] &c보유 중인 능력이 아닙니다." to {_p}
			play sound "ENTITY_PLAYER_ATTACK_CRIT" to {_p}
			stop
		remove speed, jump boost from {_p}
		delete {ability::tamaki::%uuid of {_p}%}
		delete {nekofire::%uuid of {_p}%}
		set {_p}'s safe fall distance attribute to 3
		remove fire resistance from {_p}
	else if {_type} is "kusakabe":
		if {ability::kusakabe::%uuid of {_p}%} is not set:
			send "&a[시스템] &c보유 중인 능력이 아닙니다." to {_p}
			play sound "ENTITY_PLAYER_ATTACK_CRIT" to {_p}
			stop
		remove fire charge named "&7관전자로 변경" from {_p}'s inventory
		remove goat horn named "&c능력 사용" from {_p}'s inventory
		delete {ability::kusakabe::%uuid of {_p}%}
		delete {kusakabe_ab::%uuid of {_p}%}
		delete {kusakabe_cooldown::%uuid of {_p}%}
		delete {spectator_used::%uuid of {_p}%}
		remove fire resistance from {_p}
	else if {_type} is "iris":
		if {ability::iris::%uuid of {_p}%} is not set:
			send "&a[시스템] &c보유 중인 능력이 아닙니다." to {_p}
			play sound "ENTITY_PLAYER_ATTACK_CRIT" to {_p}
			stop
		remove end crystal named "&d능력 사용" from {_p}'s inventory
		delete {ability::iris::%uuid of {_p}%}
		delete {iris_cooldown::%uuid of {_p}%}
		remove fire resistance from {_p}
		remove glowing from {_p}
		remove resistance from {_p}
		execute console command "team leave %{_p}%"

	else:
		send "&a[시스템] &e'%{_type}%'&c은 존재하지 않는 능력 입니다." to {_p}
		play sound "ENTITY_PLAYER_ATTACK_CRIT" to {_p}
		stop
	
	send "&a[시스템] &e'%{_type}%' &c능력이 해제되었습니다." to {_p}
		
	play sound "BLOCK_FIRE_EXTINGUISH" to {_p}

command /ability <string>:
	trigger:
		giveAbility(player, arg 1)
command /reset [<string>]:
	trigger:
		if arg 1 is set:
			resetAbility(player, arg 1)
		else:
			resetAbility(player, "all")
command /abilities:
	trigger:
		openGUI(player)

on inventory click:
	if event-inventory's name is "&b[능력 선택]":
		cancel event
		if clicked slot = 17:
			close player's inventory
			play sound "UI_BUTTON_CLICK" to player
		if clicked slot = 2:
			if {ability::kusakabe::%uuid of player%} is true:
				resetAbility(player, "kusakabe")
			else if {ability::kusakabe::%uuid of player%} is not set:
				giveAbility(player, "kusakabe")
			openGUI(player)
		if clicked slot = 4:
			if {ability::iris::%uuid of player%} is true:
				resetAbility(player, "iris")
			else if {ability::iris::%uuid of player%} is not set:
				giveAbility(player, "iris")
			openGUI(player)
		if clicked slot = 6:
			if {ability::tamaki::%uuid of player%} is true:
				resetAbility(player, "tamaki")
			else if {ability::tamaki::%uuid of player%} is not set:
				giveAbility(player, "tamaki")
			openGUI(player)
on right click:
	if player's tool is fire charge:
		if name of player's tool is "&7관전자로 변경":
			cancel event
			send "&a[시스템] &e'화염구' &c사용이 금지 돼있습니다." to player
			play sound "ENTITY_VILLAGER_NO" to player
	if player's tool is end crystal:
		if name of player's tool is "&d능력 사용":
			cancel event
			send "&a[시스템] &e'엔드 크리스탈' &c사용이 금지 돼있습니다." to player
			play sound "ENTITY_VILLAGER_NO" to player
on death of player:
	resetAbility(victim, "all")